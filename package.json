{
  "name": "zensu-copilot",
  "version": "0.2.0",
  "private": true,
  "description": "Complete Zensu workflow plugin for GitHub Copilot CLI",
  "license": "FSL-1.1-Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "check": "node scripts/check.js",
