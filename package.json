{
  "name": "zensu-copilot",
  "version": "0.6.0",
  "private": true,
  "description": "Complete Zensu workflow plugin for GitHub Copilot CLI",
  "license": "FSL-1.1-Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "check": "node scripts/check.js",
    "test": "node --test tests/copilot/*.test.js tests/core/*.test.js",
    "test:marketplace": "python3 -m unittest discover -s tests/marketplace -v",
    "test:validation": "python3 scripts/test-native-workflow-analyzer.py && python3 scripts/test-live-workflow-harness.py",
    "test:coverage": "node --experimental-test-coverage --test tests/copilot/*.test.js tests/core/*.test.js",
    "verify": "npm run build && npm run check && npm test && npm run test:marketplace && npm run test:validation"
  }
}
